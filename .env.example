# ===== 密钥 =====
# DeepSeek 官方：主模型入口
DEEPSEEK_API_KEY=

# 百炼 OpenAI 兼容口：备用入口，D5 验证 fallback 时使用
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== 模型 =====
MODEL_PRIMARY=deepseek/deepseek-chat
MODEL_BACKUP=qwen-plus
MODEL_STRONG=deepseek/deepseek-reasoner

# ===== 裁剪策略 =====
# 人为设定的策略上限，用于制造可复现的超窗对照
# 5000：30 轮语料会在第 23 轮左右越线，既有对照又留出裁剪余量
MAX_CONTEXT=5000
# 最近 N 轮原文保留
RECENT_TURNS=8

# ===== Redis（D3 摘要缓存）=====
# 本机源码编译安装的 Redis，默认库 0
REDIS_URL=redis://localhost:6379/0

# ===== PostgreSQL（D4 成本落库）=====
# 本机源码编译安装，端口避开默认 5432 则同步修改 storage.py
POSTGRES_URL=postgresql://pgadmin@localhost:5433/agentboard

# ===== 网络 =====
# 本地代理必须绕过这些域名，否则高并发流式请求会大面积超时
NO_PROXY=api.deepseek.com,dashscope.aliyuncs.com,localhost,127.0.0.1

# ===== LiteLLM =====
# 使用本地内置价格表，跳过每次启动联网拉取 cost map（国内网络会超时卡数秒）
LITELLM_LOCAL_MODEL_COST_MAP=True

# ===== LiteLLM Proxy（D5）=====
# 网关地址；留空 = 直连模式，填地址 = 网关模式（切换只改这里）
PROXY_URL=http://localhost:4000
